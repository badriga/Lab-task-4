#sum of digits of a number
def sum_digits(n):
    if n == 0:
        return 0
    else:
        return n % 10 + sum_digits(n // 10)
n = int(input("Enter a number: "))
print("Sum of digits:", sum_digits(n))
#fibonacci series
def fibonacci(n):
    if n <= 1:
        return n
    else:
        return fibonacci(n-1) + fibonacci(n-2)
n = int(input("Enter number of terms: "))
for i in range(n):
    print(fibonacci(i), end=" ")
