#palindrome
def palindrome():
    a=int(input("enter a:"))
    b=0
    t=a
    while t>0:
        d=t%10
        b=(b*10)+d
        t=t//10
    print("b:",b)
    if b==a:
       print("palindrome")
    else:
        print("not a palindrome")
palindrome()
